# ─────────────────────────────────────────────────────────────────────────────
# Identifiants push — MODÈLE, non synchronisé par ArgoCD (extension `.example` :
# le fichier est ignoré du répertoire de l'app). Renommer en
# `push-credentials.yaml` une fois les secrets présents dans OpenBao.
#
# DEUX CAS, mutuellement exclusifs :
#
#  1. Push délégué au serveur de Belledonne (mode par défaut de flexisip.conf,
#     seul mode compatible avec l'application Linphone du store) → seul le
#     Secret `flexisip-flexiapi` est nécessaire.
#
#  2. Certificats en propre (application recompilée avec ton bundle id / ton
#     projet Firebase) → Secrets `flexisip-apns` et/ou `flexisip-firebase`,
#     et repasser flexisip.conf en `apple=true` / `firebase=true` avec
#     `external-push-flexiapi=false`.
#
# Les volumes et la variable correspondants sont déjà déclarés optionnels dans
# le Deployment : tant que ces Secrets n'existent pas, Flexisip démarre sans
# push.
# ─────────────────────────────────────────────────────────────────────────────
---
# CAS 1 — Clé d'API du serveur de push de Belledonne (FlexiAPI).
# Obtenue auprès de Belledonne ; l'URL de base correspondante est renseignée
# dans flexisip.conf, section [global::flexiapi].
#
# Pré-requis OpenBao : kv/kubernetes/flexisip/flexiapi { api_key }
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: flexisip-flexiapi
  namespace: flexisip
  annotations:
    argocd.argoproj.io/sync-wave: "1"
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: openbao-backend
    kind: ClusterSecretStore
  target:
    name: flexisip-flexiapi
    creationPolicy: Owner
  data:
    - secretKey: api_key
      remoteRef:
        key: kubernetes/flexisip/flexiapi
        property: api_key
---
# CAS 2 — iOS : certificat APNs au format PEM (certificat + clé privée concaténés),
# nommé d'après l'app id : <appid>.prod.pem / <appid>.dev.pem, et
# <appid>.voip.prod.pem pour PushKit (appels entrants).
#
# Pré-requis OpenBao : kv/kubernetes/flexisip/apns { <appid>.prod.pem: <PEM> }
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: flexisip-apns
  namespace: flexisip
  annotations:
    argocd.argoproj.io/sync-wave: "1"
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: openbao-backend
    kind: ClusterSecretStore
  target:
    name: flexisip-apns
    creationPolicy: Owner
  data:
    # La clé du Secret devient le nom de fichier dans /etc/flexisip/apn/
    - secretKey: com.example.monapp.prod.pem
      remoteRef:
        key: kubernetes/flexisip/apns
        property: prod_pem
    - secretKey: com.example.monapp.voip.prod.pem
      remoteRef:
        key: kubernetes/flexisip/apns
        property: voip_prod_pem
---
# CAS 2 — Android : compte de service Firebase (JSON) du projet qui possède l'app.
# Pré-requis OpenBao : kv/kubernetes/flexisip/firebase { service_account }
#
# Puis décommenter dans flexisip.conf :
#   firebase-service-accounts=<numéro de projet>:/etc/flexisip/firebase/firebase.json
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: flexisip-firebase
  namespace: flexisip
  annotations:
    argocd.argoproj.io/sync-wave: "1"
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: openbao-backend
    kind: ClusterSecretStore
  target:
    name: flexisip-firebase
    creationPolicy: Owner
  data:
    - secretKey: firebase.json
      remoteRef:
        key: kubernetes/flexisip/firebase
        property: service_account
