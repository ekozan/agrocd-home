# ─────────────────────────────────────────────────────────────────────────────
# Identifiants push (APNs / Firebase) — MODÈLE, non synchronisé par ArgoCD
# (extension `.example` : le fichier est ignoré du répertoire de l'app).
#
# Renommer en `push-credentials.yaml` une fois les secrets présents dans
# OpenBao. Les deux volumes correspondants sont déjà déclarés `optional: true`
# dans le Deployment : tant que ces Secrets n'existent pas, Flexisip démarre
# sans push.
#
# ⚠️  Rappel : ces identifiants sont ceux de TON application. Avec le Linphone
# du store, les jetons push appartiennent à Belledonne et ne peuvent pas être
# adressés par ce serveur (cf. README.md § Push).
# ─────────────────────────────────────────────────────────────────────────────
---
# iOS — certificat APNs au format PEM (certificat + clé privée concaténés),
# nommé d'après l'app id : <appid>.prod.pem / <appid>.dev.pem, et
# <appid>.voip.prod.pem pour PushKit (appels entrants).
#
# Pré-requis OpenBao : kv/kubernetes/flexisip/apns { <appid>.prod.pem: <PEM> }
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: flexisip-apns
  namespace: flexisip
  annotations:
    argocd.argoproj.io/sync-wave: "1"
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: openbao-backend
    kind: ClusterSecretStore
  target:
    name: flexisip-apns
    creationPolicy: Owner
  data:
    # La clé du Secret devient le nom de fichier dans /etc/flexisip/apn/
    - secretKey: com.example.monapp.prod.pem
      remoteRef:
        key: kubernetes/flexisip/apns
        property: prod_pem
    - secretKey: com.example.monapp.voip.prod.pem
      remoteRef:
        key: kubernetes/flexisip/apns
        property: voip_prod_pem
---
# Android — compte de service Firebase (JSON) du projet qui possède l'app.
# Pré-requis OpenBao : kv/kubernetes/flexisip/firebase { service_account }
#
# Puis décommenter dans flexisip.conf :
#   firebase-service-accounts=<numéro de projet>:/etc/flexisip/firebase/firebase.json
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: flexisip-firebase
  namespace: flexisip
  annotations:
    argocd.argoproj.io/sync-wave: "1"
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: openbao-backend
    kind: ClusterSecretStore
  target:
    name: flexisip-firebase
    creationPolicy: Owner
  data:
    - secretKey: firebase.json
      remoteRef:
        key: kubernetes/flexisip/firebase
        property: service_account
